# Gemini Developer API (used for RAG embeddings, generation, and Mem0 OSS)
GEMINI_API_KEY=

# Optional remote Qdrant for the document index
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=data/qdrant
QDRANT_COLLECTION=child_chunks

# Cohere ReRank
COHERE_API_KEY=
RERANK_MODEL=rerank-english-v3.0
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.0

# Mem0 OSS local semantic memory (no MEM0_API_KEY required)
MEM0_LLM_MODEL=gemini-2.0-flash
MEM0_EMBEDDING_MODEL=models/gemini-embedding-001
MEM0_EMBEDDING_DIMS=768
MEM0_QDRANT_PATH=data/mem0_qdrant
MEM0_COLLECTION=personal_memories
MEM0_HISTORY_DB_PATH=data/mem0_history.db

# Future API settings
DENSE_TOP_K=20
SPARSE_TOP_K=20
RETRIEVAL_TOP_K=20
RRF_K=60
