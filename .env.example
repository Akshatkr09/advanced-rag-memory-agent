# Gemini Developer API
GEMINI_API_KEY=

# Optional remote Qdrant. If omitted, persistent local Qdrant is used.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=data/qdrant
QDRANT_COLLECTION=child_chunks

# Cohere ReRank (used in M4)
COHERE_API_KEY=
RERANK_MODEL=rerank-english-v3.0
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.0

# Later milestone
MEM0_API_KEY=

# Retrieval settings
DENSE_TOP_K=20
SPARSE_TOP_K=20
RETRIEVAL_TOP_K=20
RRF_K=60
